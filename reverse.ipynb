      "source": [
        "num= int(input(\"Enter a number: \"))\n",
        "rev =0\n",
        "while num> 0:\n",
        "    digit =num %10\n",
        "    rev= rev* 10 + digit\n",
        "    num =num// 10\n",
        "print(\"Reversed number =\", rev)\n"
      ]
    }
  ],
